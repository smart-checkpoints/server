# Port the REST API, the console and both realtime channels are served on.
PORT=3000

# Which interfaces to listen on. The default is loopback, so a server that is
# started and left alone is not reachable from the network at all. Cameras and
# distance drivers do have to reach it, so a real deployment sets this - the
# point is that opening the server up is a decision somebody made rather than
# something that happened by default...
#
# HOST=0.0.0.0

# Password for /admin, which lists every project on this server together with
# its API key. Leave it unset and /admin is switched off entirely.
ADMIN_PASSWORD=1234

# --- Sayes agent ---------------------------------------------------------
#
# Anthropic API key for the Sayes agent. Read on this server only: it is
# never sent to the console. Leave it unset and the agent is switched off;
# everything else runs as normal.
ANTHROPIC_API_KEY=

# Model and how much it thinks. `between_tools` is the fastest setting (no
# extended thinking, short progress notes between actions); `adaptive` lets
# the model think when it decides to. Effort: low, medium or high.
#AGENT_MODEL=claude-sonnet-5-5
#AGENT_THINKING=between_tools
#AGENT_EFFORT=medium

# How long the server waits after announcing an action before sending it, so
# the change lands as the on-screen cursor arrives. 0 sends immediately.
#AGENT_CURSOR_LEAD_MS=700

# Loop guards: actions per operator message, model turns per message, and
# actions per conversation.
#AGENT_MAX_TOOL_CALLS_PER_RUN=25
#AGENT_MAX_TURNS_PER_RUN=10
#AGENT_MAX_TOOL_CALLS_PER_SESSION=100

# Operator key of the project `npm run demo:1|2|3` resets and seeds before a
# recording. Everything in that project except its keys and the agent's audit
# log is deleted on every run, so never point it at a real project. Leave it
# unset and the first run creates a "Sayes demo" project and prints its key.
#DEMO_API_KEY=
