# Port the REST API, the console and both realtime channels are served on.
PORT=3000

# Which interfaces to listen on. The default is loopback, so a server that is
# started and left alone is not reachable from the network at all. Cameras and
# distance drivers do have to reach it, so a real deployment sets this - the
# point is that opening the server up is a decision somebody made rather than
# something that happened by default.
#
# HOST=0.0.0.0

# Password for /admin, which lists every project on this server together with
# its API key. Leave it unset and /admin is switched off entirely.
ADMIN_PASSWORD=1234
