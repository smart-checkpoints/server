{
  "name": "smart-checkpoints-server",
  "version": "1.0.0",
  "private": true,
  "description": "The Smart Checkpoints server: the checkpoint graph, the enforcement path, and the operator console that drives them.",
  "license": "MIT",
  "main": "server.js",
  "workspaces": [
    "console"
  ],
  "scripts": {
    "build": "npm run build --workspace console",
